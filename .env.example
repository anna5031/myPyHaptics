# Copy this file to .env and replace placeholders with real values.
BHAPTICS_APP_ID=your_app_id
BHAPTICS_API_KEY=your_api_key
BHAPTICS_APP_NAME=Hello, bHaptics!

# MQTT defaults used by both bHpaticsMetronomeController.py and bHapticsRelay.py.
MQTT_BROKER=mqtt-web.makinteract.com
MQTT_PORT=1883
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_RETAIN=false
MQTT_USERNAME=
MQTT_PASSWORD=
